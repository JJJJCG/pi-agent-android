# 换行符策略。
#
# 这个文件不是可选项：Windows 上 autocrlf 会把 gradlew 换成 CRLF，
# 到了 Linux 的 CI 里 shebang 变成 "#!/bin/sh\r"，直接 bad interpreter。
# 所以脚本一律强制 LF。

* text=auto eol=lf

# shell / Gradle 脚本必须 LF
gradlew          text eol=lf
*.sh             text eol=lf

# Windows 批处理反过来要 CRLF
*.bat            text eol=crlf
gradlew.bat      text eol=crlf

# 二进制：别做任何换行转换，也别尝试 diff
*.jar            binary
*.so             binary
*.onnx           binary
*.wav            binary
*.apk            binary
*.png            binary
*.jpg            binary
*.webp           binary

# 生成物不参与语言统计
app/build/**     linguist-generated=true
gradlew.bat      linguist-generated=true
gradle/wrapper/gradle-wrapper.jar binary linguist-generated=true
