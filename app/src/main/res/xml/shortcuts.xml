<?xml version="1.0" encoding="utf-8"?>
<!--
  静态快捷方式：长按桌面上的 App 图标，直接开 / 关后台监听。

  为什么是两条而不是一条：
  一个「切换」入口在菜单里看不出当前会往哪个方向走 —— 用户得先想起来现在
  是开是关。拆成「打开监听」「关闭监听」两条，点哪个就是哪个，语义明确。

  为什么走 Activity 而不是直接 startService：
  静态快捷方式只能指向 Activity，系统不允许快捷方式直达 Service。所以统一
  交给 .service.WakeToggleActivity 处理。

  两条怎么区分：
  <shortcut> 本身只能带 intent，不能直接塞 extras，所以用 action 区分 ——
  开是 SET_WAKE_ON，关是 SET_WAKE_OFF，Activity 按 action 决定方向。
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_wake_on"
        android:shortcutId="wake_on"
        android:shortcutShortLabel="@string/shortcut_wake_on_short"
        android:shortcutLongLabel="@string/shortcut_wake_on_long">
        <intent
            android:action="com.pi.assistant.action.SET_WAKE_ON"
            android:targetClass="com.pi.assistant.service.WakeToggleActivity"
            android:targetPackage="com.pi.assistant" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_wake_off"
        android:shortcutId="wake_off"
        android:shortcutShortLabel="@string/shortcut_wake_off_short"
        android:shortcutLongLabel="@string/shortcut_wake_off_long">
        <intent
            android:action="com.pi.assistant.action.SET_WAKE_OFF"
            android:targetClass="com.pi.assistant.service.WakeToggleActivity"
            android:targetPackage="com.pi.assistant" />
    </shortcut>

</shortcuts>
