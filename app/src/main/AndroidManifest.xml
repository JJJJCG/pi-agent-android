<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 连 pi（局域网明文 HTTP，见 network_security_config） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 读当前 Wi-Fi 名（SSID）用于「仅指定 Wi-Fi 下监听」，双轨声明：
         · 13+：授权「附近设备」即可（neverForLocation，全程不碰定位）
         · 12 及以下：只能用定位权限，且系统定位开关要打开，
           否则系统一律只回 <unknown ssid>，读不到名字 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- 语音：录音 + 常驻麦克风的前台服务 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+ 起，前台服务用麦克风必须有这一条，少一个直接崩 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- 引导用户把 App 加进电池优化白名单（厂商保活只能尽力而为） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 麦克风是可选硬件，没有也不该被商店过滤掉 -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".PiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PiAgent"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PiAgent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 长按桌面图标弹出的静态快捷方式（见 res/xml/shortcuts.xml） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          快捷方式的中转页：Android 的静态快捷方式只能指向 Activity，
          所以「开 / 关后台监听」这两个动作由它代收，处理完立刻 finish，
          全程不可见（主题是 Theme.PiAgent.Transparent）。
          exported=true 是必须的 —— 快捷方式的 intent 由系统服务发出。
        -->
        <activity
            android:name=".service.WakeToggleActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PiAgent.Transparent">
            <!-- 开 / 关各一条 action，由 shortcuts.xml 里对应的快捷方式发出 -->
            <intent-filter>
                <action android:name="com.pi.assistant.action.SET_WAKE_ON" />
                <action android:name="com.pi.assistant.action.SET_WAKE_OFF" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          常驻唤醒服务。foregroundServiceType 必须是 microphone，
          且运行时还要有 FOREGROUND_SERVICE_MICROPHONE 权限。
          只由用户在设置页 / 快捷方式 / 磁贴手动开启，不做自启动。
        -->
        <service
            android:name=".service.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          下拉快捷设置里的「后台监听」磁贴。
          BIND_QUICK_SETTINGS_TILE 权限由系统持有，所以 exported 必须为 true。
        -->
        <service
            android:name=".service.WakeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_wake"
            android:label="@string/tile_wake_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
